# Settings of the private teacher pilot. Copy to .env with scripts/init-env.sh, which fills in the
# generated secrets. This file holds placeholders only and is safe to commit. The real file is
# ignored by Git, must be readable only by its owner (chmod 600), and is never sent anywhere.

# ---- the deployment ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=compalign_pilot

# The public address teachers will use, with https. Moodle's address is fixed at install time:
# set it right before the first start (changing it later is documented, but not free).
MOODLE_WWWROOT=https://pilot.example.org

# Moodle's web server listens on this port of 127.0.0.1 only. The host's nginx forwards to it.
MOODLE_HOST_PORT=8080

# Timezone Moodle shows dates in. The pilot's own records are always UTC.
MOODLE_TIMEZONE=UTC
MOODLE_SITE_NAME=Competency Alignment Pilot
MOODLE_SITE_SHORTNAME=CA Pilot

# Address of the administrator account. It cannot receive mail either: nothing sends mail.
MOODLE_ADMIN_EMAIL=admin@pilot.invalid
# Leave at 0. At 1 Moodle would try to send mail, and no mail server is configured.
MOODLE_ALLOW_EMAIL=0

# ---- the private Docker network ---------------------------------------------------------------
# Pick a range nothing else on the host uses (docker network ls; docker network inspect ...).
PILOT_SUBNET=172.29.80.0/24
# The alignment service's fixed address inside that range. Moodle reaches it at http://<this>.
ALIGNMENT_IP=172.29.80.10

# ---- secrets, generated by scripts/init-env.sh ------------------------------------------------
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=CHANGE_ME_generated
MOODLE_ADMIN_PASSWORD=CHANGE_ME_generated
ALIGNMENT_SERVICE_TOKEN=CHANGE_ME_generated

# ---- the model ----------------------------------------------------------------------------------
# gemini for the pilot. "mock" returns deterministic test output and must NEVER be used with teachers.
ALIGNMENT_BACKEND=gemini
# The key is entered with scripts/set-secret.sh GEMINI_API_KEY, never typed into a command line.
GEMINI_API_KEY=
# Leave blank to use the engine's default model.
GEMINI_MODEL=
ALIGNMENT_MODEL=

# ---- limits -------------------------------------------------------------------------------------
# Seconds Moodle waits for the service, and the most suggestions shown per resource.
PLUGIN_REQUEST_TIMEOUT=120
PLUGIN_MAX_SUGGESTIONS=3
# The service refuses larger request bodies.
ALIGNMENT_MAX_BODY_BYTES=2000000
ALIGNMENT_LOG_LEVEL=INFO

# Seconds between runs of Moodle's cron loop.
CRON_INTERVAL_SECONDS=20

# Tag for the images built here. update.sh sets a new one for each release so rollback is possible.
PILOT_IMAGE_TAG=pilot
