# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Contains a Moodle userprivateaccesskey
reports/site_info.json

# ---------------------------------------------------------------------------
# Environments, caches, editors
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
node_modules/
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Archives and build output
# ---------------------------------------------------------------------------
# Release archives belong in GitHub Releases, not in the tree.
*.zip
*.tar.gz
*.tgz
*.mbz
!*.zip.sha256

# dist/ is a generated duplicate of the tree plus release archives.
dist/
build/
*.egg-info/

# ---------------------------------------------------------------------------
# Private / raw Moodle data
# ---------------------------------------------------------------------------
# Raw API and SQL dumps may carry private Moodle fields.
data/raw/

# Logs
reports/logs/
*.log

# External reference repository, not part of this project.
# Obtain it separately. Do not redistribute it from this repository.
data/source/

# Local copies of test review rows. Not validation and not for publication.
data/private/

# Superseded working copies
data/gold/manual_fragment_annotations_before_reset.csv
data/reviews/teacher_reviews_before_fix_20260918.csv
data/interim/gemini_pilot_manifest.json
data/interim/gemini_pilot_raw.json
data/interim/gemini_pilot_response.jsonl
data/interim/gemini_pilot_validated.jsonl

# Runtime demo manifests, not the frozen experiment
data/runtime/manifests/*.json

# Local safety backups — superseded by the files they back up
backups/
data/gold/annotation_backups/
data/reviews/evidence_review_backups/
data/reviews/corpus_teacher_review_backups/

# Runtime application output — not part of the reported experiment
data/runtime/uploads/
data/runtime/resources/
data/runtime/fragments/
data/runtime/retrieval/
data/runtime/model_responses/
data/runtime/analyses/

# ---------------------------------------------------------------------------
# Local supervision material. Kept on disk, not part of the public tree.
# ---------------------------------------------------------------------------
archive/
FINAL_DELIVERY/
FINAL_PACKAGE_CONTENTS.md
docs/handoff/
docs/internal/
docs/meeting/
docs/SUPERVISOR_DEMO.md
docs/TEACHER_DEMO_GUIDE.md
meeting/
presentations/
presentation/
paper_drafts/
utc_forms/

*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc

tmp/
temp/
.cache/

# Package and handoff builders. The evaluation scripts stay tracked.
scripts/build_final_package_zip.py
scripts/build_handoff_zip.py
scripts/collect_handoff_facts.py
tests/test_handoff_facts.py

# Narrative reports stay local. Measured metrics, tables, and figures
# remain available for reproduction.
reports/*
!reports/metrics/
!reports/tables/
!reports/figures/
!reports/reproducibility_manifest.json
!reports/live_gemini_verification.json

# ---------------------------------------------------------------------------
# Private teacher pilot (deploy/pilot): secrets, credentials, backups and logs never go in Git.
# (.env and .env.* are already ignored above; .env.example is kept.)
# ---------------------------------------------------------------------------
deploy/pilot/private/
deploy/pilot/backups/
deploy/pilot/logs/
deploy/pilot/releases/
deploy/pilot/PILOT_RECORD.json
teacher_credentials*.csv
*.credentials.csv

# ---------------------------------------------------------------------------
# Deliberately NOT ignored — required for reproducibility
# ---------------------------------------------------------------------------
#   data/processed/          normalised corpus, fragments, competencies
#   data/interim/            BM25 candidates, model tasks, model responses
#   data/gold/               human-reviewed reference annotations
#   data/reviews/evidence_review.csv
#   data/studies/            evidence-usefulness pilot design
#   data/experiments/        post-hoc and optional experiment outputs
#   reports/metrics/         measured results
#   reports/tables/          result tables
#   reports/figures/         figures
