# Configuration for the Python alignment service (service/).
#
# Put real values in the repository-root .env (ignored by git), or export them in
# the shell. Variables already set in the shell win over the file.
# Never commit a real token or key.
#
# Only ALIGNMENT_*, GEMINI_API_KEY, GEMINI_MODEL, OLLAMA_HOST and OLLAMA_MODEL are
# read from the file. Moodle database credentials and MOODLE_TOKEN in the same
# .env belong to the research scripts and are deliberately ignored by the service.

# Required. The shared secret the Moodle plugin sends as
#   Authorization: Bearer <token>
# At least 16 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Enter the same value in the Moodle plugin settings. Without it every request to
# /v1/* is refused.
ALIGNMENT_SERVICE_TOKEN=

# Model backend: gemini (default) | ollama | mock
# "mock" returns deterministic test output and never calls a model. Its results
# are labelled backend=mock and must not be used for a teacher study.
ALIGNMENT_BACKEND=gemini

# Optional model override. Otherwise GEMINI_MODEL / OLLAMA_MODEL are used.
ALIGNMENT_MODEL=

# Provider settings, read by the research engine. They stay on this host and are
# never sent to Moodle.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# OLLAMA_HOST=
# OLLAMA_MODEL=

# Optional hardening and diagnostics.
# ALIGNMENT_MAX_BODY_BYTES=2000000
# ALIGNMENT_ENABLE_DOCS=0
# ALIGNMENT_LOG_LEVEL=INFO
# ALIGNMENT_ENV_FILE=/path/to/another.env
