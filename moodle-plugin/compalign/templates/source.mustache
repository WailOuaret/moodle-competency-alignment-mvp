{{!
    @template local_compalign/source

    A quotation highlighted inside the resource text it came from.

    Context variables required for this template:
    * title - Resource title
    * type - Activity type
    * provenance - Where the quotation sits
    * html - Escaped surrounding text. The quotation is wrapped in mark
    * found - Whether the quotation was located
    * errormessage - A teacher-facing error, when the quotation cannot be shown
    * openurl - Address of the Moodle activity
    * backurl - Address of the review page
}}
<div class="local-compalign-source">
    <p><a href="{{{backurl}}}">{{#str}} backtoreview, local_compalign {{/str}}</a></p>
    <h3 class="h4">{{title}}</h3>
    <p class="text-muted">{{type}}</p>
    {{#hasprovenance}}<p>{{provenance}}</p>{{/hasprovenance}}
    {{#found}}
        <div class="border rounded p-3 local-compalign-source-text">{{{html}}}</div>
    {{/found}}
    {{^found}}
        <div class="alert alert-warning" role="alert">{{errormessage}}</div>
    {{/found}}
    {{#openurl}}
        <p class="mt-3"><a href="{{{openurl}}}">{{#str}} openmoodleresource, local_compalign {{/str}}</a></p>
    {{/openurl}}
</div>
