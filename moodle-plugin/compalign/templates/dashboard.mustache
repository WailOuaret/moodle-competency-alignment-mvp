{{!
    @template local_compalign/dashboard

    The course dashboard: every resource with its analysis status, official links and next action.

    Context variables required for this template:
    * hasissues - Whether the assistant is not ready
    * issues - Reasons: text, hasdetails and details (each with text)
    * hasrows - Whether the course has resources to list
    * rows - One per resource: name, url, typename, statuskey, statuslabel, statustype, progress, haslinks,
      links (each with text) and action (html, or url and label, or text)
    * showoverviewlink - Whether to link to the plugin overview
    * overviewurl - Address of the plugin overview

    Example context (json):
    {
        "hasissues": false,
        "issues": [],
        "hasrows": true,
        "rows": [
            {
                "name": "Software Development Lifecycle and Deployment",
                "url": "https://example.org/mod/page/view.php?id=3",
                "typename": "Page",
                "statuskey": "ready",
                "statuslabel": "Suggestions ready",
                "statustype": "primary",
                "progress": "1 of 2 reviewed",
                "haslinks": true,
                "links": [{"text": "GI_C1_1 Concevoir"}],
                "action": {"url": "https://example.org/local/compalign/review.php?cmid=3", "label": "View suggestions"}
            }
        ],
        "showoverviewlink": true,
        "overviewurl": "https://example.org/local/compalign/index.php"
    }
}}
<div class="local-compalign-dashboard">
    <p>{{#str}} dashboard_intro, local_compalign {{/str}}</p>

    {{#hasissues}}
        <div class="alert alert-warning" role="alert">
            <strong>{{#str}} dashboard_notready, local_compalign {{/str}}</strong>
            <ul class="mb-0">
                {{#issues}}
                    <li>{{text}}
                        {{#hasdetails}}
                            <ul>
                                {{#details}}<li>{{text}}</li>{{/details}}
                            </ul>
                        {{/hasdetails}}
                    </li>
                {{/issues}}
            </ul>
        </div>
    {{/hasissues}}

    <nav class="mb-3" aria-label="{{#str}} filter_all, local_compalign {{/str}}">
        <div class="mb-1">
            {{#filters}}
                {{^typefilter}}
                    <a class="{{classes}}" href="{{{url}}}" {{#active}}aria-current="page"{{/active}}>{{label}}</a>
                {{/typefilter}}
            {{/filters}}
        </div>
        <div>
            {{#filters}}
                {{#typefilter}}
                    <a class="{{classes}}" href="{{{url}}}" {{#active}}aria-current="page"{{/active}}>{{label}}</a>
                {{/typefilter}}
            {{/filters}}
        </div>
    </nav>

    {{#hasrows}}
        <div class="table-responsive">
            <table class="generaltable table table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col">{{#str}} column_resource, local_compalign {{/str}}</th>
                        <th scope="col">{{#str}} column_status, local_compalign {{/str}}</th>
                        <th scope="col">{{#str}} column_reviewed, local_compalign {{/str}}</th>
                        <th scope="col">{{#str}} column_proposals, local_compalign {{/str}}</th>
                        <th scope="col">{{#str}} column_official, local_compalign {{/str}}</th>
                        <th scope="col">{{#str}} column_action, local_compalign {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                        <tr>
                            <th scope="row">
                                {{#showgroup}}<span class="text-muted">{{groupname}}</span><br>{{/showgroup}}
                                {{#url}}<a href="{{{url}}}">{{name}}</a>{{/url}}
                                {{^url}}{{name}}{{/url}}
                                <br><small>{{typename}}</small>
                                {{#provenance}}<br><small>{{provenance}}</small>{{/provenance}}
                            </th>
                            <td data-label="{{#str}} column_status, local_compalign {{/str}}">
                                <span class="badge bg-{{statustype}}">{{statuslabel}}</span>
                                {{#progress}}<br><small>{{progress}}</small>{{/progress}}
                                <br><small>{{#str}} status_reviewed_count, local_compalign, {{reviewedcount}} {{/str}}</small>
                                <br><small>{{#str}} status_official_count, local_compalign, {{officialcount}} {{/str}}</small>
                                <br><small>{{#str}} status_writeback, local_compalign, {{writeback}} {{/str}}</small>
                            </td>
                            <td data-label="{{#str}} column_reviewed, local_compalign {{/str}}">
                                {{#hasreviewed}}
                                    <ul class="list-unstyled mb-0">
                                        {{#reviewed}}<li><strong>{{text}}</strong><br><small>{{origin}}</small></li>{{/reviewed}}
                                    </ul>
                                {{/hasreviewed}}
                                {{^hasreviewed}}<span class="text-muted">{{#str}} reviewed_none, local_compalign {{/str}}</span>{{/hasreviewed}}
                                {{#hasstale}}
                                    <ul class="list-unstyled mb-0 mt-2">
                                        {{#stalereviewed}}
                                            <li><strong>{{text}}</strong><br><small>{{#str}} reviewed_stale, local_compalign {{/str}}</small></li>
                                        {{/stalereviewed}}
                                    </ul>
                                {{/hasstale}}
                                {{#haswarnings}}
                                    <ul class="mb-0 mt-2">
                                        {{#warnings}}<li>{{text}}</li>{{/warnings}}
                                    </ul>
                                {{/haswarnings}}
                            </td>
                            <td data-label="{{#str}} column_proposals, local_compalign {{/str}}">
                                {{#hasproposals}}
                                    <ul class="list-unstyled mb-0">
                                        {{#proposals}}<li>{{text}}</li>{{/proposals}}
                                    </ul>
                                {{/hasproposals}}
                                {{^hasproposals}}<span class="text-muted">{{#str}} proposals_none, local_compalign {{/str}}</span>{{/hasproposals}}
                            </td>
                            <td data-label="{{#str}} column_official, local_compalign {{/str}}">
                                {{#haslinks}}
                                    <ul class="list-unstyled mb-0">
                                        {{#links}}<li>{{text}}</li>{{/links}}
                                    </ul>
                                {{/haslinks}}
                                {{^haslinks}}<span class="text-muted">{{#str}} official_none_help, local_compalign {{/str}}</span>{{/haslinks}}
                            </td>
                            <td>
                                {{#action.html}}{{{action.html}}}{{/action.html}}
                                {{#action.url}}<a class="btn btn-secondary btn-sm" href="{{{action.url}}}">{{action.label}}</a>{{/action.url}}
                                {{#action.text}}<span class="text-muted">{{action.text}}</span>{{/action.text}}
                            </td>
                        </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>
    {{/hasrows}}
    {{^hasrows}}
        <p class="text-muted">{{#str}} dashboard_noresources, local_compalign {{/str}}</p>
    {{/hasrows}}

    {{#hasselectable}}
        <form method="post" action="{{{batchurl}}}" class="mt-3">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="batch">
            <fieldset>
                <legend>{{#str}} batch_legend, local_compalign {{/str}}</legend>
                <p>{{#str}} batch_help, local_compalign, {{maxbatch}} {{/str}}</p>
                {{#selectable}}
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="items[]" value="{{resourceid}}" id="{{domid}}">
                        <label class="form-check-label" for="{{domid}}">{{groupname}} — {{name}}</label>
                    </div>
                {{/selectable}}
                <button type="submit" class="btn btn-secondary mt-2">{{#str}} batch_submit, local_compalign {{/str}}</button>
            </fieldset>
        </form>
    {{/hasselectable}}

    {{#showoverviewlink}}
        <p><a href="{{{overviewurl}}}">{{#str}} plugin_overview, local_compalign {{/str}}</a></p>
    {{/showoverviewlink}}
</div>
