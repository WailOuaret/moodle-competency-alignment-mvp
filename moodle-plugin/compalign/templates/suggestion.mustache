{{!
    @template local_compalign/suggestion

    One suggested competency with its evidence, any hierarchy note, collapsed technical details and the
    teacher's decision form. It shows no reference label, prompt, model reasoning or raw response.

    Context variables required for this template:
    * id - Suggestion id
    * code - Competency idnumber
    * name - Competency name
    * description - The pedagogical description, without catalogue metadata
    * englishlabel - Alternate English label, when the catalogue has one
    * sourceuri - Source address from the catalogue, when present
    * extraid - A catalogue identifier that is not the id already shown as code
    * evidence - Exact quotations, each with quote
    * haswarnings - Whether there is a hierarchy note
    * warnings - Each with text
    * bm25rank - Retrieval rank, or a placeholder
    * confidence - Model confidence, or a placeholder
    * supportcount - Number of supporting passages
    * passages - Passage ids, comma separated
    * reviewed - The teacher's latest decision: summary and saved. Absent when not reviewed yet
    * form - The rendered decision form

    Example context (json):
    {
        "id": 1,
        "code": "GI_C1_1",
        "name": "Concevoir des logiciels",
        "description": "Design software systems.",
        "evidence": [{"quote": "Software design defines the architecture."}],
        "haswarnings": true,
        "warnings": [{"text": "Its parent competency (GI_C1) is also suggested for this resource."}],
        "bm25rank": 1,
        "confidence": "0.80",
        "supportcount": 2,
        "passages": "moodle:page:1#f001, moodle:page:1#f002",
        "reviewed": {"summary": "Accepted", "saved": "Revision 1, saved Saturday, 3 October 2026, 11:00 PM"},
        "form": "<form></form>"
    }
}}
<div class="card mb-4 local-compalign-card" id="suggestion-{{id}}">
    <div class="card-header">
        <span class="text-muted small">{{#str}} proposedcompetency, local_compalign {{/str}}</span>
        <h4 class="h5 mb-0"><span class="badge bg-secondary">{{code}}</span> {{name}}</h4>
    </div>
    <div class="card-body">
        {{#description}}<p>{{description}}</p>{{/description}}

        <h5 class="h6">{{#str}} evidenceheading, local_compalign {{/str}}</h5>
        {{#evidence}}
            <blockquote class="blockquote border-start ps-3 mb-2">
                <p class="mb-0 fs-6">{{quote}}</p>
                {{#source}}<footer class="blockquote-footer">{{source}}</footer>{{/source}}
            </blockquote>
        {{/evidence}}

        {{#haswarnings}}
            <div class="alert alert-warning mt-3" role="note">
                <strong>{{#str}} hierarchywarning, local_compalign {{/str}}</strong>
                <ul class="mb-0">
                    {{#warnings}}<li>{{text}}</li>{{/warnings}}
                </ul>
            </div>
        {{/haswarnings}}

        <details class="my-3">
            <summary>{{#str}} technicaldetails, local_compalign {{/str}}</summary>
            <dl class="row mt-2 mb-0">
                <dt class="col-sm-4">{{#str}} bm25rank, local_compalign {{/str}}</dt>
                <dd class="col-sm-8">{{bm25rank}}</dd>
                <dt class="col-sm-4">{{#str}} modelconfidence, local_compalign {{/str}}</dt>
                <dd class="col-sm-8">{{confidence}}</dd>
                <dt class="col-sm-4">{{#str}} supportcount, local_compalign {{/str}}</dt>
                <dd class="col-sm-8">{{supportcount}}</dd>
                <dt class="col-sm-4">{{#str}} passages, local_compalign {{/str}}</dt>
                <dd class="col-sm-8">{{passages}}</dd>
                {{#englishlabel}}
                    <dt class="col-sm-4">{{#str}} englishlabel, local_compalign {{/str}}</dt>
                    <dd class="col-sm-8">{{englishlabel}}</dd>
                {{/englishlabel}}
                {{#extraid}}
                    <dt class="col-sm-4">{{#str}} catalogueid, local_compalign {{/str}}</dt>
                    <dd class="col-sm-8">{{extraid}}</dd>
                {{/extraid}}
                {{#sourceuri}}
                    <dt class="col-sm-4">{{#str}} sourceuri, local_compalign {{/str}}</dt>
                    <dd class="col-sm-8">{{sourceuri}}</dd>
                {{/sourceuri}}
            </dl>
        </details>

        <hr>
        {{#reviewed}}
            <div class="alert alert-success" role="status">
                <strong>{{#str}} yourdecision, local_compalign {{/str}}:</strong> {{summary}}<br>
                <small>{{saved}}</small>
            </div>
        {{/reviewed}}
        {{^reviewed}}
            <p class="text-muted">{{#str}} notreviewed, local_compalign {{/str}}</p>
        {{/reviewed}}

        {{{form}}}
    </div>
</div>
