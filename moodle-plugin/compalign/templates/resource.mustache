{{!
    @template local_compalign/resource

    The page of one resource: official links, the state of its analysis, and the suggestion cards.

    Context variables required for this template:
    * heading - Page heading
    * typename - Resource type, for example Page
    * coursename - Name of the course
    * backurl - Address of the course dashboard
    * haslinks - Whether the resource has official competency links
    * links - Each with idnumber and shortname
    * notices - Each with type (success, info, warning or danger), role, title and text
    * actionhtml - A rendered button that starts or repeats the analysis, or empty
    * hascards - Whether there are suggestions
    * cards - Suggestion cards, rendered with local_compalign/suggestion

    Example context (json):
    {
        "heading": "Competency suggestions: Software Development Lifecycle and Deployment",
        "typename": "Page",
        "coursename": "Software Engineering and Distributed Systems",
        "backurl": "https://example.org/local/compalign/index.php?courseid=2",
        "haslinks": true,
        "links": [{"idnumber": "GI_C1_1", "shortname": "Concevoir"}],
        "notices": [{"type": "info", "role": "status", "title": "", "text": "Official write-back is off."}],
        "actionhtml": "",
        "hascards": false,
        "cards": []
    }
}}
<div class="local-compalign-resource">
    <p><a href="{{{backurl}}}">{{#str}} backtodashboard, local_compalign {{/str}}</a></p>

    <h3 class="h4">{{heading}}</h3>
    <p class="text-muted">{{typename}} &middot; {{coursename}}</p>
    {{#hasprovenance}}<p>{{provenance}}</p>{{/hasprovenance}}

    <section class="mb-4" aria-labelledby="local-compalign-reviewed">
        <h3 class="h5" id="local-compalign-reviewed">{{#str}} column_reviewed, local_compalign {{/str}}</h3>
        {{#hasreviewedsummary}}
            <ul>
                {{#reviewedsummary}}
                    <li>
                        <strong>{{text}}</strong> — {{origin}}
                        {{#stale}}<br><span class="text-warning">{{#str}} reviewed_stale, local_compalign {{/str}}</span>{{/stale}}
                        {{#removehtml}}<br>{{{removehtml}}}{{/removehtml}}
                    </li>
                {{/reviewedsummary}}
            </ul>
        {{/hasreviewedsummary}}
        {{^hasreviewedsummary}}
            <p class="text-muted">{{#str}} reviewed_none, local_compalign {{/str}}</p>
        {{/hasreviewedsummary}}
        {{#summarywarnings}}<p class="text-warning">{{text}}</p>{{/summarywarnings}}
        {{#canadd}}<p><a class="btn btn-secondary" href="{{{addurl}}}">{{#str}} addcompetency, local_compalign {{/str}}</a></p>{{/canadd}}
    </section>

    <section aria-labelledby="local-compalign-links">
        <h3 class="h5" id="local-compalign-links">{{#str}} officiallinks, local_compalign {{/str}}</h3>
        {{#haslinks}}
            <ul>
                {{#links}}<li><strong>{{idnumber}}</strong> {{shortname}}</li>{{/links}}
            </ul>
            <p class="text-muted">{{#str}} writeback_still_off, local_compalign {{/str}}</p>
        {{/haslinks}}
        {{^haslinks}}
            <p class="text-muted">{{#str}} official_none_help, local_compalign {{/str}}</p>
        {{/haslinks}}
    </section>

    {{#notices}}
        <div class="alert alert-{{type}}" role="{{role}}">
            {{#title}}<strong>{{title}}</strong><br>{{/title}}
            {{text}}
        </div>
    {{/notices}}

    {{#actionhtml}}
        <div class="mb-4">{{{actionhtml}}}</div>
    {{/actionhtml}}

    {{#hascards}}
        {{#cards}}
            {{> local_compalign/suggestion }}
        {{/cards}}
    {{/hascards}}
</div>
